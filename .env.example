# Polymarket Bracket Arbitrage Bot — Configuration

# Execution mode: dry_run (default, safe) or live (requires wallet)
EXECUTION_MODE=dry_run

# Minimum NET profit per pair to consider an opportunity.
# Net edge = 1.00 - Yes_ask - No_ask - fee_buffer - slippage_buffer
# Must be >= this value. Default $0.01
MIN_PROFIT_MARGIN=0.01

# Maximum USDC to deploy per trade
MAX_CAPITAL_PER_TRADE=50

# Safety buffers — subtracted from gross edge to get net edge
# Fee buffer: covers Polymarket taker fees (currently 0%, but may change)
FEE_BUFFER=0.005
# Slippage buffer: covers stale order book data / latency
SLIPPAGE_BUFFER=0.005

# Poll interval in seconds
POLL_INTERVAL_SECONDS=5

# Number of top markets to scan per cycle (by volume).
# Set to a high number (e.g., 1000) to scan ALL active markets.
# Note: scanning more markets increases API load.
MAX_MARKETS_PER_SCAN=100

# Minimum market liquidity (USDC) to consider
MIN_LIQUIDITY_USDC=1000

# API request timeout (seconds)
REQUEST_TIMEOUT=10

# Max retries on rate limit (429)
MAX_RETRIES=3

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
