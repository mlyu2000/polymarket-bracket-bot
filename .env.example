# Polymarket Bracket Arbitrage Bot — Configuration

# Execution mode: dry_run (default, safe) or live (requires wallet)
EXECUTION_MODE=dry_run

# Minimum profit per pair (Yes + No) to consider an opportunity
# Must cover gas/fees. Default $0.02
MIN_PROFIT_MARGIN=0.02

# Maximum USDC to deploy per trade
MAX_CAPITAL_PER_TRADE=50

# Poll interval in seconds
POLL_INTERVAL_SECONDS=5

# Number of top markets to scan per cycle (by volume)
MAX_MARKETS_PER_SCAN=100

# Minimum market liquidity (USDC) to consider
MIN_LIQUIDITY_USDC=1000

# API request timeout (seconds)
REQUEST_TIMEOUT=10

# Max retries on rate limit (429)
MAX_RETRIES=3

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
